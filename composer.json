{
  "name": "restruct/silverstripe-admintweaks",
  "description": "Various admin tweaks & enhancements",
  "type": "silverstripe-vendormodule",
  "keywords": [
    "silverstripe"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Restruct",
      "email": "dev@restruct.nl",
      "homepage": "https://restruct.nl"
    }
  ],
  "require": {
    "php": "^8.1",
    "silverstripe/framework": "^4 | ^5",
    "guzzlehttp/guzzle": "^7.0"
  },
  "replace": {
    "micschk/silverstripe-cmstweaks": "1.*",
    "restruct/silverstripe-cmstweaks": "*"
  },
  "suggest": {
    "restruct/silverstripe-login-branding": "Reduce Silverstripe branding of the admin login and make it easily configurable",
    "symbiote/silverstripe-grouped-cms-menu": "Group CMS menu items into nested lists",
    "wedevelopnl/silverstripe-webp-images": "WEBP image support (output resized jpeg/png images as webp, GD with WEBP required)",
    "axllent/silverstripe-cms-tweaks": "Some complemental tweaks by Axllent",
    "symbiote/silverstripe-multivaluefield": "Needed for MultivalueSortField (a sort-only MultiValueDropdownField)",
    "symbiote/silverstripe-gridfieldextensions": "Needed for GridFieldConfigs, GridFieldConfig_VersionedOrderable and the editable GridField fixes",
    "silverstripe/lumberjack": "Needed for SelectiveLumberjack and GridFieldSiteTreeAddNewButton"
  },
  "autoload": {
    "psr-4": {
      "Restruct\\Silverstripe\\AdminTweaks\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Restruct\\Silverstripe\\AdminTweaks\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "extra": {
    "expose": [
      "client/dist"
    ]
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "silverstripe/vendor-plugin": true,
      "silverstripe/recipe-plugin": true
    }
  }
}
